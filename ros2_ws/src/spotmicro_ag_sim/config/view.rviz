Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 640
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Line Style:
        Value: Lines
        Line Width: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.12
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
    - Class: rviz_default_plugins/Imu
      Name: IMU
      Enabled: true
      Topic:
        Value: /imu/data
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 79; 209; 197
      Alpha: 1
      Scale: 0.2
  Global Options:
    Fixed Frame: base_link
    Background Color: 32; 36; 42
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.85
      Pitch: 0.42
      Yaw: 0.85
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 880
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
