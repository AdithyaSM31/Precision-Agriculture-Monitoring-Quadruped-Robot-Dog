<?xml version="1.0" ?>
<!-- Self-contained crop field. The sun and ground plane are inline rather than
     model:// includes: GAZEBO_MODEL_PATH is not always populated by sourcing the
     ROS setup, and gzserver then stalls on the online model database. -->
<sdf version="1.6">
  <world name="crop_field">

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse><specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane"><static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>2e5</kp><kd>15</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.30 0.26 0.20 1</ambient><diffuse>0.42 0.36 0.27 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crop_0"><static>true</static>
